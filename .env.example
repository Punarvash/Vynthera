# All optional. The site works without any of them; keys raise rate limits or enable AI summaries.

# Free: https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management). Raises PubMed limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Free: https://open.fda.gov/apis/authentication/ . Raises openFDA limit to 120,000 requests/day.
OPENFDA_API_KEY=

# Paid (usage-based): https://console.anthropic.com/ . Without it, summaries quote the study abstracts instead.
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-haiku-5-5 for lower cost. Default: claude-opus-5-5.
CLAUDE_MODEL=

# Development only: serve placeholder data instead of calling the real APIs. Never set in production.
VYNTHERA_DEMO_DATA=
